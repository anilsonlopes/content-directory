# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# Nuxt Studio (/_studio em produção): OAuth App do GitHub com callback
# https://content-directory.quila.dev/__nuxt_studio/auth/github
NUXT_STUDIO_AUTH_GITHUB_CLIENT_ID=
NUXT_STUDIO_AUTH_GITHUB_CLIENT_SECRET=
# e-mails que podem editar, separados por vírgula; vazio libera qualquer conta do GitHub
NUXT_STUDIO_AUTH_GITHUB_MODERATORS=
